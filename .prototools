proto = "0.57.3"
moon = "2.3.0"

act = "*"
actionlint = "*"
argo = "*"
argocd = "*"
commitlint = "*"
dprint = "*"
ghalint = "*"
hadolint = "*"
helm = "*"
helmfile = "*"
hyperfine = "*"
kubeconform = "*"
kubectl = "*"
kubectx = "*"
kustomize = "*"
lefthook = "*"
pinact = "*"
shellcheck = "*"
shellspec = "*"
shfmt = "*"
skaffold = "*"
task = "*"
terraform-docs = "*"
terraformer = "*"
tflint = "*"
tilt = "*"
zizmor = "*"

[plugins]
act = "file://./toml/act.toml"
actionlint = "file://./toml/actionlint.toml"
argo = "file://./toml/argo.toml"
argocd = "file://./toml/argocd.toml"
commitlint = "file://./toml/commitlint.toml"
dprint = "file://./toml/dprint.toml"
ghalint = "file://./toml/ghalint.toml"
hadolint = "file://./toml/hadolint.toml"
helm = "file://./toml/helm.toml"
helmfile = "file://./toml/helmfile.toml"
hyperfine = "file://./toml/hyperfine.toml"
kubeconform = "file://./toml/kubeconform.toml"
kubectl = "file://./toml/kubectl.toml"
kubectx = "file://./toml/kubectx.toml"
kustomize = "file://./toml/kustomize.toml"
lefthook = "file://./toml/lefthook.toml"
pinact = "file://./toml/pinact.toml"
shellcheck = "file://./toml/shellcheck.toml"
shellspec = "file://./toml/shellspec.toml"
shfmt = "file://./toml/shfmt.toml"
skaffold = "file://./toml/skaffold.toml"
