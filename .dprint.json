{
  "json": {
    "trailingCommas": "never",
    "preferSingleLine": false
  },
  "markdown": {
    "lineWidth": 100,
    "textWrap": "maintain"
  },
  "toml": {
    "lineWidth": 100
  },
  "yaml": {
    "lineWidth": 100,
    "indentWidth": 2
  },
  "golangci": {
    "version": "2.5.0"
  },
  "includes": [
    "**/*.{json,md,toml,yaml,yml,go}"
  ],
  "excludes": [
    "**/node_modules",
    "**/vendor",
    "**/.moon/cache",
    "**/tools/plugin-gen/target"
  ],
  "plugins": [
    "https://plugins.dprint.dev/json-0.20.0.wasm",
    "https://plugins.dprint.dev/markdown-0.19.0.wasm",
    "https://plugins.dprint.dev/toml-0.7.0.wasm",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.5.1.wasm",
    "https://github.com/ageha734/dprint-plugin-golangci/releases/download/v1.2.1/plugin.json@b7d04c51dc5c6ffaadb049ee3ab003afc13b843e64c1f2a038b4d4426e2146d6"
  ]
}
